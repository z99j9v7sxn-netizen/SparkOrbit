# Docker Compose 运行期配置（复制为 .env 后按需填写）
# 勿提交含真实密钥的 .env

# 宿主机访问端口（前端 Nginx）
HOST_PORT=80

# MySQL root 密码（compose 内 backend 会使用同一密码）
MYSQL_ROOT_PASSWORD=sparkorbit

# —— 推荐填写：核心 LLM ——
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# —— 可选能力 ——
QWEN_API_KEY=
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=
# 数字人视频大模型（可选；未填则回退上方 XF_*）
XF_DH_APP_ID=
XF_DH_API_KEY=
XF_DH_API_SECRET=
CANTONESE_AI_API_KEY=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_SEEDANCE_MODEL=
ARK_SEEDANCE_FOUNDATION_MODEL=doubao-seedance-1-0-pro-fast-251015
