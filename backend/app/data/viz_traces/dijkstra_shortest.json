  "code": "import heapq\n\ndef dijkstra(graph, start, target):\n    dist = {start: 0}\n    pq = [(0, start)]\n    while pq:\n        d, u = heapq.heappop(pq)\n        if u == target:\n            return d\n        for v, w in graph.get(u, []):\n            nd = d + w\n            if nd < dist.get(v, float('inf')):\n                dist[v] = nd\n                heapq.heappush(pq, (nd, v))\n    return dist.get(target, float('inf'))\n\ngraph = {'S': [('A', 4), ('B', 2)], 'A': [('T', 3)], 'B': [('A', 1), ('T', 5)], 'T': []}\ndijkstra(graph, 'S', 'T')\n",
