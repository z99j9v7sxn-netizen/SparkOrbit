# 本地开发默认使用 MySQL（IDEA 环境）
# 先在 MySQL 中执行：CREATE DATABASE sparkorbit CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/sparkorbit?charset=utf8mb4

# 无 MySQL 时可临时兜底：
# DATABASE_URL=sqlite+aiosqlite:///./sparkorbit.db

# 空库建表：cd backend && alembic upgrade head
# （应用启动 init_db 也会优先执行 upgrade；失败时才 create_all 兜底）

# JWT 会话密钥（生产务必更换）
JWT_SECRET=sparkorbit-dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# DeepSeek — 文本智能体（可选；与豆包二选一或同时配置）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 文本模型优先：auto | deepseek | doubao
# auto：有 DeepSeek 用 DeepSeek，否则走豆包；设为 doubao 可强制用火山方舟豆包
LLM_PROVIDER=auto

# 火山方舟文本（豆包）— 未配 DeepSeek 时作为智能体文本兜底
# ARK_CHAT_MODEL 填文本接入点 ID（ep-...）；空则回退到 ARK_VISION_MODEL
ARK_CHAT_MODEL=

# 通义千问 — 自拍卡通化
QWEN_API_KEY=
QWEN_BASE_URL=https://ws-eabsfkhsqysf9ux7.cn-beijing.maas.aliyuncs.com
QWEN_IMAGE_MODEL=qwen-image-edit

# RAG 知识外挂（ChromaDB，依赖见 requirements.txt 中的 chromadb）
# 启动 seed 会将各行星大纲 upsert 到 backend/chroma_data/
# 未安装或初始化失败时自动降级：Tutor/判题回退行星描述伪源

# 讯飞 — 语音听写 IAT / 口语评测 ISE / 在线 TTS
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=
# 伴学舱数字人口播发音人（在线合成）
XF_TTS_VCN=xiaoyan

# 讯飞 — 数字人视频大模型（必须用该服务详情页的 APIKey，不要只用听写/评测密钥）
# 文档: https://www.xfyun.cn/doc/spark/videoGenerate.html
# 控制台路径：虚拟数字人 → 数字人视频大模型 → 我的应用 → APIKey/APISecret
# 若只用 XF_*（听写）回退，可能出现：创建成功但 task_status 一直停在 1/2 直到超时
XF_DH_APP_ID=
XF_DH_API_KEY=
XF_DH_API_SECRET=
XF_DH_HOST=vms.cn-huadong-1.xf-yun.com
XF_DH_WORD_COUNT=80
XF_DH_POLL_INTERVAL=5
XF_DH_TIMEOUT=900

# 讯飞 — 虚拟人交互平台（avatar-sdk-web；计费=WebSocket 展示时长，按需连接）
XF_VMS_APP_ID=
XF_VMS_API_KEY=
XF_VMS_API_SECRET=
XF_VMS_SCENE_ID=
XF_VMS_AVATAR_ID=201293001
XF_VMS_VCN=x7_langxiao_pro
XF_VMS_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
XF_VMS_IDLE_SEC=90

# cantonese.ai — 粤语 STT + 发音评分（密钥仅写本地 .env）
CANTONESE_AI_API_KEY=
CANTONESE_AI_BASE_URL=https://cantonese.ai/api

# ffmpeg — 口语录音转码；未加入系统 PATH 时填写 bin 目录或 ffmpeg.exe 完整路径
# FFMPEG_PATH=D:\ffmpeg-8.1.2-essentials_build\bin

# 火山方舟 Seedance — 视频生成（密钥仅写本地 .env）
# ARK_SEEDANCE_MODEL 填接入点 ID（ep-...）；FOUNDATION 填模型 ID（展示用）
# 默认文生视频：text 内嵌 --resolution/--ratio/--duration；配置封面 URL 后走图生视频
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_SEEDANCE_MODEL=ep-m-xxxxxxxx
ARK_SEEDANCE_FOUNDATION_MODEL=doubao-seedance-1-0-pro-fast-251015
ARK_SEEDANCE_DURATION=12
ARK_SEEDANCE_RESOLUTION=720p
ARK_SEEDANCE_RATIO=16:9
ARK_SEEDANCE_POLL_INTERVAL=10
ARK_SEEDANCE_TIMEOUT=480
# 可选：图生视频封面公网 URL；空则文生视频（不使用官方示例图）
# ARK_SEEDANCE_IMAGE_URL=https://example.com/cover.png

# 火山方舟视觉 — PDF 画笔问伴学 / 错题识图 / 模拟面试关键帧（ARK_VISION_MODEL 填接入点 ID）
ARK_VISION_MODEL=ep-xxxxxxxx
ARK_VISION_FOUNDATION_MODEL=Doubao-Seed-2.1-pro

# 模拟面试区依赖（缺则自动降级，不阻断文本作答）
# - XF_*：一题一条 IAT（eos=9000）+ 在线 TTS；缺则浏览器语音 / 文本兜底
# - XF_VMS_*：数字人面试官；缺则 TTS / speechSynthesis
# - ARK_VISION_*：关键帧仪态评分；可用 runtime_config interview_vision_enabled=0 关闭
# - FFMPEG_PATH：口语转码（面试主链路用 PCM，可不配）


# 代码舱 Docker sidecar（compose 默认内网；本机单独跑 backend 时可改本机地址）
# CODELAB_RUNNER_URL=http://codelab-runner:8091
# CODELAB_RUNNER_URL=http://127.0.0.1:8091
